<Project Sdk="Microsoft.NET.Sdk.Razor">

  <PropertyGroup>
    <TargetFrameworks>net10.0-android;net10.0-ios;net10.0-maccatalyst</TargetFrameworks>
    <TargetFrameworks Condition="$([MSBuild]::IsOSPlatform('windows'))">$(TargetFrameworks);net10.0-windows10.0.19041.0</TargetFrameworks>
    <TargetFrameworks Condition="$([MSBuild]::IsOSPlatform('windows')) and '$(MSBuildRuntimeType)' != 'Full'">net10.0-windows10.0.19041.0</TargetFrameworks>
    <OutputType>Exe</OutputType>
    <RootNamespace>SciCalc</RootNamespace>
    <UseMaui>true</UseMaui>
    <SingleProject>true</SingleProject>
    <ApplicationTitle>SciCalc</ApplicationTitle>
    <ApplicationId>com.scicalc.app</ApplicationId>
    <ApplicationDisplayVersion>1.0</ApplicationDisplayVersion>
    <ApplicationVersion>1</ApplicationVersion>

    <!-- Run unpackaged so the exe can be launched directly (dotnet run) without MSIX
         package identity; packaged activation fails with REGDB_E_CLASSNOTREG. -->
    <WindowsPackageType>None</WindowsPackageType>

    <!-- Ship the Windows App SDK with the app so unpackaged launch works on machines
         without the Windows App SDK runtime installed. -->
    <WindowsAppSDKSelfContained>true</WindowsAppSDKSelfContained>
    <SupportedOSPlatformVersion Condition="$([MSBuild]::GetTargetPlatformIdentifier('$(TargetFramework)')) == 'ios'">14.2</SupportedOSPlatformVersion>
    <SupportedOSPlatformVersion Condition="$([MSBuild]::GetTargetPlatformIdentifier('$(TargetFramework)')) == 'maccatalyst'">14.0</SupportedOSPlatformVersion>
    <SupportedOSPlatformVersion Condition="$([MSBuild]::GetTargetPlatformIdentifier('$(TargetFramework)')) == 'android'">21.0</SupportedOSPlatformVersion>
    <SupportedOSPlatformVersion Condition="$([MSBuild]::GetTargetPlatformIdentifier('$(TargetFramework)')) == 'windows'">10.0.17763.0</SupportedOSPlatformVersion>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.AspNetCore.Components.WebView.Maui" />
    <PackageReference Include="Microsoft.Extensions.Logging.Debug" />
    <PackageReference Include="Microsoft.Maui.Controls" />
  </ItemGroup>

  <ItemGroup>
    <MauiIcon Include="Resources\AppIcon\appicon.svg" />
    <MauiSplashScreen Include="Resources\Splash\splash.svg" BaseSize="128,128" Color="#1e1e28" />
  </ItemGroup>

  <!-- *.razor.css is claimed by the default MauiCss glob (**/*.css), and MAUI's
       DefaultItems.targets removes **/*.css from @(None), so the Razor scoped-CSS
       pipeline never sees it and no SciCalc.Maui.styles.css bundle is generated.
       Release it from MauiCss and pass it to scoped CSS discovery via @(Content). -->
  <ItemGroup>
    <MauiCss Remove="**\*.razor.css" />
    <Content Include="**\*.razor.css" Exclude="$(DefaultItemExcludes)" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\..\Domain\SciCalc.Domain\SciCalc.Domain.csproj" />
  </ItemGroup>

</Project>
