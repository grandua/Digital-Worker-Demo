@using SciCalc.Domain
@using System.Globalization
@inject Calculator Calc

<div class="calc" role="group" aria-label="Scientific calculator" tabindex="0" @onkeydown="HandleKeyDown">
    <header class="calc-header">
        <div class="brand-lockup">
            <div class="brand-mark" aria-hidden="true">∑</div>
            <div class="title-stack">
                <span class="calc-title">SciCalc</span>
                <span class="calc-subtitle">Precision, made simple</span>
            </div>
        </div>
        <button class="mode-toggle" disabled="@Calc.Locked" @onclick="() => Press(InputKey.DegRadToggle)" aria-label="@ModeToggleName">
            <span class="mode-dot" aria-hidden="true"></span>
            <span aria-live="polite">@ModeText</span>
        </button>
    </header>
    <section class="display" aria-label="Calculator display">
        <div class="display-meta">
            <span>SCIENTIFIC MODE</span>
            <span class="display-live" aria-hidden="true"><span class="live-dot"></span>LIVE</span>
        </div>
        @if (Calc.Locked)
        {
            <div class="error-title" role="alert">Error</div>
            <div class="error-reason">@Reason(Calc.ActiveError!.Value)</div>
        }
        else
        {
            <div class="entry">@ExpressionText</div>
            <div class="result">@ResultText</div>
        }
        <div class="sr-only" role="status" aria-live="polite">@StatusText</div>
    </section>
    <section class="memory" aria-label="Memory slots">
        <div class="memory-heading">MEMORY</div>
        @foreach (MemorySlot slot in memorySlots)
        {
            <div class="mem-group" @key="slot.Id">
                <span class="mem-badge @(Calc.Memory.IsNonEmpty(slot.Id) ? "on" : "")" aria-label="@MemoryBadgeName(slot)">@slot.Name</span>
                <button class="key mem" disabled="@Calc.Locked" @onclick="() => Press(slot.Store)" aria-label="@MemoryButtonName("Store in", slot)">STO</button>
                <button class="key mem" disabled="@Calc.Locked" @onclick="() => Press(slot.Recall)" aria-label="@MemoryButtonName("Recall", slot)">MR</button>
                <button class="key mem" disabled="@Calc.Locked" @onclick="() => Press(slot.Clear)" aria-label="@MemoryButtonName("Clear", slot)">MC</button>
            </div>
        }
    </section>
    <div class="calc-body">
        <section class="keypad">
            <div class="pad sci">
                @foreach (KeyDefinition key in functionKeys)
                {
                    <button class="key sci" disabled="@Calc.Locked" @key="key.Key" @onclick="() => Press(key.Key)" aria-label="@KeyName(key)">@key.Label</button>
                }
            </div>
            <div class="pad main">
                @foreach (KeyDefinition key in mainKeys)
                {
                    <button class="@key.Style" disabled="@(Calc.Locked && key.Key != InputKey.AllClear)" @key="key.Key" @onclick="() => Press(key.Key)" aria-label="@KeyName(key)">@key.Label</button>
                }
            </div>
        </section>
        <aside class="history-panel">
            <h2 class="history-title">History</h2>
            @if (Calc.History.Count == 0)
            {
                <p class="history-empty">No calculations yet.</p>
            }
            else
            {
                <div class="history-list">
                    @foreach (var item in NewestFirst)
                    {
                        <button class="history-item" disabled="@Calc.Locked" @key="item.Index" @onclick="() => Restore(item.Entry)" aria-label="@HistoryItemName(item.Entry)">
                            <span class="history-expression">@HistoryText(item.Entry.Tokens)</span>
                            <span class="history-result">= @Format(item.Entry.ResultValue)</span>
                        </button>
                    }
                </div>
            }
        </aside>
    </div>
</div>

@code {
    // TODO(review): Add component coverage for every keypad route and rendered session state.
    private readonly Dictionary<OperatorKind, string> operatorGlyphs = new()
    {
        [OperatorKind.Add] = "+",
        [OperatorKind.Subtract] = "−",
        [OperatorKind.Multiply] = "×",
        [OperatorKind.Divide] = "÷",
        [OperatorKind.Power] = "^",
        [OperatorKind.Modulo] = "mod",
    };
    private readonly Dictionary<FunctionKind, string> functionGlyphs = new()
    {
        [FunctionKind.Sin] = "sin",
        [FunctionKind.Cos] = "cos",
        [FunctionKind.Tan] = "tan",
        [FunctionKind.Asin] = "asin",
        [FunctionKind.Acos] = "acos",
        [FunctionKind.Atan] = "atan",
        [FunctionKind.Sinh] = "sinh",
        [FunctionKind.Cosh] = "cosh",
        [FunctionKind.Tanh] = "tanh",
        [FunctionKind.Log10] = "log",
        [FunctionKind.Ln] = "ln",
        [FunctionKind.Exp] = "e^",
        [FunctionKind.TenPow] = "10^",
        [FunctionKind.Square] = "sqr",
        [FunctionKind.Cube] = "cube",
        [FunctionKind.Sqrt] = "√",
        [FunctionKind.Cbrt] = "∛",
        [FunctionKind.Abs] = "abs",
        [FunctionKind.Reciprocal] = "recip",
    };
    private readonly Dictionary<ConstantKind, string> constantGlyphs = new()
    {
        [ConstantKind.Pi] = "π",
        [ConstantKind.E] = "e",
    };

    private readonly List<KeyDefinition> functionKeys =
    [
        new("sin", InputKey.Sin),
        new("cos", InputKey.Cos),
        new("tan", InputKey.Tan),
        new("asin", InputKey.Asin, Name: "Arcsine"),
        new("acos", InputKey.Acos, Name: "Arccosine"),
        new("atan", InputKey.Atan, Name: "Arctangent"),
        new("sinh", InputKey.Sinh, Name: "Hyperbolic sine"),
        new("cosh", InputKey.Cosh, Name: "Hyperbolic cosine"),
        new("tanh", InputKey.Tanh, Name: "Hyperbolic tangent"),
        new("log", InputKey.Log10, Name: "Common logarithm base 10"),
        new("ln", InputKey.Ln, Name: "Natural logarithm"),
        new("eˣ", InputKey.Exp, Name: "E to the power of x"),
        new("10ˣ", InputKey.TenPow, Name: "Ten to the power of x"),
        new("n!", InputKey.Factorial, Name: "Factorial"),
        new("x²", InputKey.Square, Name: "Square"),
        new("x³", InputKey.Cube, Name: "Cube"),
        new("√", InputKey.Sqrt, Name: "Square root"),
        new("³√", InputKey.Cbrt, Name: "Cube root"),
        new("1/x", InputKey.Reciprocal, Name: "Reciprocal"),
        new("|x|", InputKey.Abs, Name: "Absolute value"),
        new("π", InputKey.Pi, Name: "Pi"),
        new("e", InputKey.E, Name: "Euler's number"),
    ];

    private readonly List<KeyDefinition> mainKeys =
    [
        new("AC", InputKey.AllClear, "key danger", Name: "All clear"),
        new("DEL", InputKey.Delete, "key warn", Name: "Delete last input"),
        new("(", InputKey.OpenParen, Name: "Open parenthesis"),
        new(")", InputKey.CloseParen, Name: "Close parenthesis"),
        new("÷", InputKey.Divide, Name: "Divide"),
        new("7", InputKey.Digit7),
        new("8", InputKey.Digit8),
        new("9", InputKey.Digit9),
        new("%", InputKey.Percent, Name: "Percent"),
        new("×", InputKey.Multiply, Name: "Multiply"),
        new("4", InputKey.Digit4),
        new("5", InputKey.Digit5),
        new("6", InputKey.Digit6),
        new("^", InputKey.Power, Name: "Power"),
        new("−", InputKey.Subtract, Name: "Subtract"),
        new("1", InputKey.Digit1),
        new("2", InputKey.Digit2),
        new("3", InputKey.Digit3),
        new("mod", InputKey.Modulo, Name: "Modulo"),
        new("+", InputKey.Add, Name: "Add"),
        new("0", InputKey.Digit0),
        new(".", InputKey.Dot, Name: "Decimal point"),
        new("ANS", InputKey.Ans, Name: "Insert last answer"),
        new("=", InputKey.Eq, "key equals wide", Name: "Equals"),
    ];

    private readonly List<MemorySlot> memorySlots =
    [
        new("M1", MemorySlotId.M1, InputKey.StoreM1, InputKey.RecallM1, InputKey.ClearM1),
        new("M2", MemorySlotId.M2, InputKey.StoreM2, InputKey.RecallM2, InputKey.ClearM2),
        new("M3", MemorySlotId.M3, InputKey.StoreM3, InputKey.RecallM3, InputKey.ClearM3),
    ];

    private static readonly Dictionary<string, InputKey> keyboardKeys = new()
    {
        ["0"] = InputKey.Digit0,
        ["1"] = InputKey.Digit1,
        ["2"] = InputKey.Digit2,
        ["3"] = InputKey.Digit3,
        ["4"] = InputKey.Digit4,
        ["5"] = InputKey.Digit5,
        ["6"] = InputKey.Digit6,
        ["7"] = InputKey.Digit7,
        ["8"] = InputKey.Digit8,
        ["9"] = InputKey.Digit9,
        ["."] = InputKey.Dot,
        [","] = InputKey.Dot,
        ["+"] = InputKey.Add,
        ["-"] = InputKey.Subtract,
        ["*"] = InputKey.Multiply,
        ["x"] = InputKey.Multiply,
        ["/"] = InputKey.Divide,
        ["^"] = InputKey.Power,
        ["%"] = InputKey.Percent,
        ["m"] = InputKey.Modulo,
        ["M"] = InputKey.Modulo,
        ["("] = InputKey.OpenParen,
        [")"] = InputKey.CloseParen,
        ["="] = InputKey.Eq,
        ["Backspace"] = InputKey.Delete,
        ["Delete"] = InputKey.Delete,
        ["Escape"] = InputKey.AllClear,
    };

    private IEnumerable<(HistoryEntry Entry, int Index)> NewestFirst =>
        Calc.History.Select((entry, index) => (entry, index)).Reverse();

    private string ModeText => Calc.Mode == AngleMode.Degrees ? "DEG" : "RAD";

    private string ModeToggleName => $"Angle mode {ModeText}. Press to switch to {(Calc.Mode == AngleMode.Degrees ? "radians" : "degrees")}.";

    private string ExpressionText => Calc.Buffer.Tokens.Count == 0 ? "0" : DisplayText(Calc.Buffer.Tokens, isLive: true);

    private string StatusText
    {
        get
        {
            if (Calc.Locked) return $"Error: {Reason(Calc.ActiveError!.Value)}";
            if (Calc.Buffer.Tokens.Count == 0 && Calc.LastAnswer is { } answer) return $"Result {Format(answer)}";
            if (Calc.Preview is { } preview) return $"Result {Format(preview)}";
            return string.Empty;
        }
    }

    private string MemoryBadgeName(MemorySlot slot) =>
        Calc.Memory.IsNonEmpty(slot.Id) ? $"Memory slot {slot.Name} holds a value" : $"Memory slot {slot.Name} is empty";

    private string MemoryButtonName(string action, MemorySlot slot) => $"{action} memory slot {slot.Name}";

    private string HistoryItemName(HistoryEntry entry) =>
        $"Restore calculation {HistoryText(entry.Tokens)} equals {Format(entry.ResultValue)}";

    private string HistoryText(IReadOnlyList<Token> tokens) => DisplayText(tokens, isLive: false);

    private string DisplayText(IReadOnlyList<Token> tokens, bool isLive) => string.Concat(
        tokens.Select((token, index) => RenderToken(token, isLive && index == tokens.Count - 1)));

    private string RenderToken(Token token, bool showLiveEdit) => token.Kind switch
    {
        TokenKind.Number => RenderNumber(token, showLiveEdit),
        TokenKind.Operator => operatorGlyphs[token.OperatorKind!.Value],
        TokenKind.Function => RenderFunction(token.FunctionKind!.Value),
        TokenKind.OpenParen => "(",
        TokenKind.CloseParen => ")",
        TokenKind.Percent => "%",
        TokenKind.Constant => constantGlyphs[token.ConstantKind!.Value],
        _ => string.Empty,
    };

    private string RenderNumber(Token token, bool showLiveEdit) =>
        showLiveEdit && Calc.Buffer.EditingNumber is { } editing
            ? editing
            : token.NumericValue!.Value.ToString(CultureInfo.InvariantCulture);

    private string RenderFunction(FunctionKind kind) =>
        kind == FunctionKind.Factorial ? "!" : functionGlyphs[kind];

    private string ResultText => Calc.Preview is { } preview
        ? $"= {Format(preview)}"
        : Calc.LastAnswer is { } answer ? $"= {Format(answer)}" : string.Empty;

    private void Press(InputKey key) => Calc.Press(key);

    private void Restore(HistoryEntry entry) => Calc.RestoreHistory(entry);

    private void HandleKeyDown(KeyboardEventArgs e)
    {
        if (e.CtrlKey || e.AltKey || e.MetaKey) return;
        if (keyboardKeys.TryGetValue(e.Key, out InputKey key)) Press(key);
    }

    private string Format(double value) => value.ToString("G15", CultureInfo.InvariantCulture);

    private string Reason(CalcError error) => error switch
    {
        CalcError.DivisionByZero => "Division by zero",
        CalcError.NegativeSqrt => "Negative sqrt",
        CalcError.NonPositiveLog => "Non-positive log",
        CalcError.InvalidFactorial => "Invalid factorial",
        CalcError.AsinAcosOutOfRange => "Out of domain",
        CalcError.Overflow => "Overflow",
        _ => "Malformed expression",
    };

    private sealed record KeyDefinition(string Label, InputKey Key, string Style = "key", string? Name = null);

    private string KeyName(KeyDefinition key) => key.Name ?? key.Label;

    private sealed record MemorySlot(string Name, MemorySlotId Id, InputKey Store, InputKey Recall, InputKey Clear);
}
